# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Supabase Database Configuration
